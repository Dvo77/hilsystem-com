<script>
// State
let claimedItems = {
  'lego': 'Grandma Janet',
  'coat': 'Aunt Sarah'
};
let totalClaimable = 14;

document.getElementById('digestDate').textContent =
  new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});

function openDigest(){ document.getElementById('digestOverlay').classList.add('open'); }
function closeDigest(){ document.getElementById('digestOverlay').classList.remove('open'); }
function overlayClick(e){ if(e.target===document.getElementById('digestOverlay')) closeDigest(); }

function switchDigestTab(el, name){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  ['preview','send','settings'].forEach(t=>{
    document.getElementById('tab-'+t).style.display = t===name?'':'none';
  });
}

function claim(id, claimer){
  const btn = document.getElementById('claim-'+id);
  const cb = document.getElementById('cb-'+id);
  if(!btn || btn.classList.contains('taken') || btn.classList.contains('claimed')) return;

  // Ask who is claiming
  const name = prompt('Your name:') || claimer;
  if(!name) return;

  claimedItems[id] = name;
  btn.textContent = name;
  btn.classList.remove('claim-btn');
  btn.classList.add('claim-btn','taken');

  if(cb){ cb.textContent = '✓ Claimed by ' + name; cb.classList.add('show'); }

  // Add to claimed section
  const dc = document.getElementById('dynamic-claimed');
  const labels = {
    'lego':'Maya · Lego Lamborghini pieces','etf':'Maya · ETF contribution',
    'polly':'Maya · Polly Pocket pieces','hw':'Eli · Hot Wheels track pieces',
    'mc':'Eli · Minecraft starter set','eli-trump':'Eli · Trump Account',
    'pony':'Nora · My Little Pony Sunny','nora-etf':'Nora · ETF contribution',
    'shelf':'House · Garage shelving','pantry':'House · Pantry organizer',
    'dresser':'House · Back bedroom dresser','lions':'Carrie · Lion\'s Mane',
    'jars':'Carrie · Apothecary jars','hose':'Dan · Air compressor hose',
    'hf':'Dan · Harbor Freight gift card'
  };
  const row = document.createElement('div');
  row.className='claimed-row';
  row.innerHTML=`<div class="cr-item">${labels[id]||id}</div><div class="cr-who">${name}</div>`;
  dc.appendChild(row);

  // Update counts
  const count = Object.keys(claimedItems).length;
  document.getElementById('claimedCount').textContent = count+' items';
  document.getElementById('claimStatus').textContent = count+' items claimed · '+(totalClaimable-count)+' available';
}

function removeChip(el){ el.parentNode.remove(); }

function addRecipient(){
  const input = document.getElementById('newRecipient');
  const val = input.value.trim();
  if(!val) return;
  const chips = document.getElementById('recipientChips');
  const chip = document.createElement('div');
  chip.className='chip';
  chip.innerHTML=val+' <span class="chip-remove" onclick="removeChip(this)">×</span>';
  chips.appendChild(chip);
  input.value='';
}

function setSchedule(el){
  document.querySelectorAll('.schedule-chip').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
}

function sendDigest(){
  document.querySelector('.send-now-btn').style.display='none';
  document.getElementById('sentConfirm').classList.add('show');
}
</script>
