<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Guild · HIL System</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Space+Mono:wght@400;700&family=Barlow+Condensed:wght@300;400;600&family=Fredoka:wght@500;600&display=swap" rel="stylesheet">
<script src="./hil-shell.js"></script>
<style>
  /* ── LAYOUT (mirrors Family Ledger's member-switcher pattern) ── */
  .gd-shell {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: calc(100vh - var(--hil-offset));
  }
  .gd-sidebar {
    background: #0d0d0d;
    border-right: 1px solid var(--hil-border);
    padding: 20px 0;
    position: sticky;
    top: var(--hil-offset);
    height: calc(100vh - var(--hil-offset));
    overflow-y: auto;
  }
  .gd-sidebar-section {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em;
    color: var(--hil-text-muted); text-transform: uppercase;
    padding: 0 16px; margin: 4px 0 8px;
  }
  .gd-member-card {
    margin: 0 10px 4px; padding: 10px 12px;
    border: 1px solid transparent; border-radius: 8px; cursor: pointer; transition: all 0.15s;
  }
  .gd-member-card:hover { background: var(--hil-surface-2); }
  .gd-member-card.active { background: var(--hil-surface-2); border-color: var(--hil-green); }
  .gd-member-name { font-family: var(--font-ui); font-size: 13px; font-weight: 600; color: var(--hil-text); margin-bottom: 3px; }
  .gd-member-meta { font-family: var(--font-mono); font-size: 9px; color: var(--hil-text-muted); }

  .gd-main { padding: 24px; overflow-y: auto; }

  @media (max-width: 700px) {
    .gd-shell { grid-template-columns: 1fr; }
    .gd-sidebar { position: static; height: auto; }
  }

  /* ── WELCOME BANNER (new — replaces the old cold dashboard header) ── */
  .gd-hero {
    background:
      linear-gradient(135deg, rgba(10,12,11,0.88), rgba(10,12,11,0.82)),
      url('https://raw.githubusercontent.com/Dvo77/hilsystem-com/main/hil-guild-hero.png') center 30% / cover;
    border: 1px solid var(--hil-border);
    border-radius: 16px;
    padding: 22px 24px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .gd-hero-avatars { display: flex; flex-shrink: 0; }
  .gd-bot {
    width: 52px; height: 52px; border-radius: 50%;
    display: block; object-fit: cover; overflow: hidden;
    border: 2px solid var(--hil-border);
    background: var(--hil-surface-2);
  }
  .gd-bot.patch { border-color: #38bdf8; box-shadow: 0 0 14px rgba(56,189,248,0.25); }
  .gd-bot.scratch { border-color: var(--hil-green); box-shadow: 0 0 14px rgba(0,204,102,0.25); margin-left: -14px; }
  .gd-hero-text { flex: 1; min-width: 0; }
  .gd-hero-greeting {
    font-family: 'Fredoka', var(--font-ui); font-weight: 600; font-size: 19px;
    color: var(--hil-text); margin-bottom: 4px;
  }
  .gd-hero-sub {
    font-family: var(--font-ui); font-size: 12.5px; color: var(--hil-text-muted); line-height: 1.5;
  }
  .gd-hero-stats { display: flex; gap: 10px; flex-shrink: 0; }
  .gd-pebble {
    text-align: center; padding: 8px 14px; border-radius: 12px;
    background: var(--hil-surface); border: 1px solid var(--hil-border); min-width: 64px;
  }
  .gd-pebble-val { font-family: 'Fredoka', var(--font-display); font-size: 20px; color: var(--hil-green); line-height: 1; }
  .gd-pebble.gold .gd-pebble-val { color: #f59e0b; }
  .gd-pebble-label { font-family: var(--font-mono); font-size: 8px; letter-spacing: 0.06em; color: var(--hil-text-muted); margin-top: 3px; }

  @media (max-width: 560px) {
    .gd-hero { flex-direction: column; align-items: flex-start; }
    .gd-hero-stats { width: 100%; }
    .gd-pebble { flex: 1; }
  }

  /* ── SHARED COMPONENTS ── */
  .hil-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 700px) { .hil-grid-2 { grid-template-columns: 1fr 1fr; } }

  .hil-btn {
    font-family: 'Fredoka', var(--font-ui); font-size: 12px; font-weight: 600;
    padding: 9px 18px; border: 1px solid var(--hil-border); border-radius: 999px;
    background: var(--hil-surface-2); color: var(--hil-text);
    cursor: pointer; transition: all 0.15s;
  }
  .hil-btn:hover { border-color: var(--hil-text-muted); transform: translateY(-1px); }
  .hil-btn.primary { background: var(--hil-green); color: #000; border-color: var(--hil-green); }
  .hil-btn.primary:hover { background: var(--hil-green-dim); }

  .hil-badge {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.06em;
    padding: 2px 7px; border-radius: 999px; display: inline-block;
  }
  .hil-badge.green { background: rgba(0,204,102,0.15); color: var(--hil-green); border: 1px solid var(--hil-green); }
  .hil-badge.amber { background: rgba(204,136,0,0.15); color: var(--hil-warning); border: 1px solid var(--hil-warning); }
  .hil-badge.gray  { background: var(--hil-surface-2); color: var(--hil-text-muted); border: 1px solid var(--hil-border); }
  .hil-badge.blue  { background: rgba(56,189,248,0.12); color: #38bdf8; border: 1px solid rgba(56,189,248,0.3); }
  .hil-badge.gold  { background: rgba(245,158,11,0.12); color: #f59e0b; border: 1px solid rgba(245,158,11,0.3); }

  .hil-section-label {
    font-family: 'Fredoka', var(--font-display); font-weight: 600; font-size: 13px; letter-spacing: 0.3px;
    color: var(--hil-text); border-bottom: 1px solid var(--hil-border);
    padding-bottom: 8px; margin-bottom: 14px; margin-top: 30px;
  }
  .hil-section-label:first-of-type { margin-top: 4px; }

  .hil-empty {
    text-align: center; padding: 40px 24px;
    color: var(--hil-text-muted); font-family: var(--font-ui); font-size: 12px;
    border-radius: 12px; background: var(--hil-surface); border: 1px dashed var(--hil-border);
  }
  .hil-empty-icon { font-size: 32px; margin-bottom: 12px; }

  /* ── BADGES (rounder, warmer) ── */
  .badge-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px,1fr)); gap: 12px; }
  .badge-card {
    background: var(--hil-surface); border: 1px solid var(--hil-border); border-radius: 14px;
    padding: 18px 14px; text-align: center; transition: transform 0.15s, border-color 0.15s;
  }
  .badge-card.earned { border-color: var(--hil-green); }
  .badge-card.earned:hover { transform: translateY(-2px); }
  .badge-card.locked { opacity: 0.45; }
  .badge-icon { font-size: 30px; margin-bottom: 8px; display: block; }
  .badge-name { font-family: 'Fredoka', var(--font-ui); font-weight: 600; font-size: 12px; color: var(--hil-text); margin-bottom: 4px; }
  .badge-cat { margin-bottom: 8px; }
  .badge-desc { font-family: var(--font-ui); font-size: 10.5px; color: var(--hil-text-muted); margin: 6px 0; line-height: 1.5; }
  .badge-date { font-family: var(--font-mono); font-size: 9px; color: var(--hil-green); }
  .badge-locked-label { font-family: var(--font-mono); font-size: 9px; color: var(--hil-text-muted); }

  /* ── MILESTONES (friendlier progress rows) ── */
  .milestone-row {
    background: var(--hil-surface); border: 1px solid var(--hil-border); border-radius: 12px;
    padding: 14px 16px; margin-bottom: 8px;
    display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center;
  }
  .milestone-row.completed { border-color: var(--hil-green); background: rgba(0,204,102,0.05); }
  .milestone-icon { font-size: 22px; }
  .milestone-name { font-family: 'Fredoka', var(--font-ui); font-size: 13px; color: var(--hil-text); font-weight: 600; margin-bottom: 2px; }
  .milestone-desc { font-family: var(--font-ui); font-size: 11px; color: var(--hil-text-muted); margin-bottom: 6px; }
  .milestone-reward { font-family: 'Fredoka', var(--font-display); font-size: 11px; color: #f59e0b; letter-spacing: 0.3px; white-space: nowrap; text-align: right; }
  .milestone-reward .done { color: var(--hil-green); }
  .progress-bar { height: 6px; border-radius: 999px; background: var(--hil-surface-2); width: 100%; max-width: 220px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--hil-green); transition: width 0.3s; border-radius: 999px; }

  /* ── MODULE CARDS → "mission cards" ── */
  .module-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .module-card {
    background: var(--hil-surface); border: 1px solid var(--hil-border); border-radius: 16px;
    padding: 20px; display: flex; flex-direction: column; gap: 12px;
    transition: transform 0.15s, border-color 0.15s;
  }
  .module-card:not(.dim):hover { transform: translateY(-3px); border-color: var(--hil-green); }
  .module-card.dim { opacity: 0.65; }
  .module-icon-circle {
    width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-size: 22px; background: var(--hil-surface-2); border: 1px solid var(--hil-border);
  }
  .module-title {
    font-family: 'Fredoka', var(--font-ui); font-weight: 600; font-size: 14.5px;
    color: var(--hil-text);
  }
  .module-desc { font-family: var(--font-ui); font-size: 11.5px; color: var(--hil-text-muted); line-height: 1.6; flex: 1; }
  .module-card .hil-btn { align-self: flex-start; }

  /* ── CUSTOM GOALS & CHALLENGES ── */
  .goal-card {
    background: var(--hil-surface); border: 1px solid var(--hil-border); border-radius: 14px;
    padding: 16px; margin-bottom: 10px;
  }
  .goal-card.challenge { border-color: #f59e0b; }
  .goal-top { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .goal-icon { font-size: 24px; }
  .goal-name { font-family: 'Fredoka', var(--font-ui); font-weight: 600; font-size: 13.5px; color: var(--hil-text); }
  .goal-desc { font-family: var(--font-ui); font-size: 11px; color: var(--hil-text-muted); margin-bottom: 10px; }
  .goal-timer-row { display: flex; align-items: center; gap: 10px; }
  .goal-timer-display { font-family: var(--font-mono); font-size: 13px; color: var(--hil-green); min-width: 60px; }
  .goal-progress-label { font-family: var(--font-mono); font-size: 9px; color: var(--hil-text-muted); margin-top: 6px; }

  .custom-badge-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px,1fr)); gap: 12px; margin-bottom: 10px; }

  .goal-type-toggle { display: flex; gap: 8px; margin-bottom: 4px; }
  .goal-type-btn {
    flex: 1; font-family: 'Fredoka', var(--font-ui); font-size: 11px; font-weight: 600;
    padding: 8px; border: 1px solid var(--hil-border); border-radius: 999px;
    background: var(--hil-surface-2); color: var(--hil-text-muted); cursor: pointer;
  }
  .goal-type-btn.active { border-color: var(--hil-green); color: var(--hil-green); background: rgba(0,204,102,0.08); }

  /* ── MODAL + FORM FIELDS (not previously in this file) ── */
  .hil-modal-overlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6);
    align-items: center; justify-content: center; z-index: 1000;
  }
  .hil-modal-overlay.open { display: flex; }
  .hil-modal {
    background: var(--hil-surface); border: 1px solid var(--hil-border); border-radius: 16px;
    width: 90%; max-width: 440px; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden;
  }
  .hil-modal-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 18px; border-bottom: 1px solid var(--hil-border);
    font-family: 'Fredoka', var(--font-ui); font-weight: 600; font-size: 14px; color: var(--hil-text);
  }
  .hil-modal-close { background: none; border: none; color: var(--hil-text-muted); font-size: 16px; cursor: pointer; }
  .hil-modal-close:hover { color: var(--hil-danger); }
  .hil-modal-body { padding: 18px; overflow-y: auto; flex: 1; }
  .hil-modal-footer { display: flex; justify-content: flex-end; gap: 8px; padding: 14px 18px; border-top: 1px solid var(--hil-border); }
  .hil-field { display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px; }
  .hil-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; color: var(--hil-text-muted); }
  .hil-input, .hil-textarea {
    background: var(--hil-bg); border: 1px solid var(--hil-border); color: var(--hil-text);
    font-family: var(--font-ui); font-size: 13px; padding: 8px 10px; border-radius: 8px; outline: none; width: 100%;
  }
  .hil-input:focus, .hil-textarea:focus { border-color: var(--hil-green); }
  .hil-textarea { resize: vertical; min-height: 60px; }
</style>
</head>
<body>

<div class="gd-shell">
  <aside class="gd-sidebar">
    <div class="gd-sidebar-section">Household</div>
    <div id="member-list">
      <div style="padding:12px 16px;font-family:var(--font-mono);font-size:10px;color:var(--hil-text-muted)">Loading members…</div>
    </div>
  </aside>

  <main class="gd-main">

    <div id="no-member-view" style="display:none">
      <div class="hil-empty">
        <img src="https://raw.githubusercontent.com/Dvo77/hilsystem-com/main/hil-guild-hero.png"
             alt="Welcome to the Guild" style="max-width:340px;width:100%;border-radius:16px;margin-bottom:16px;">
        <div>No household members yet.<br>Add one in Family Ledger to get started.</div>
      </div>
    </div>

    <div id="member-view" style="display:none">

      <!-- ── WELCOME BANNER ── -->
      <div class="gd-hero">
        <div class="gd-hero-avatars">
          <img class="gd-bot patch" src="https://raw.githubusercontent.com/Dvo77/hilsystem-com/main/patch-hero.png" alt="Patch">
          <img class="gd-bot scratch" src="https://raw.githubusercontent.com/Dvo77/hilsystem-com/main/scratch-hero.png" alt="Scratch">
        </div>
        <div class="gd-hero-text">
          <div class="gd-hero-greeting" id="gd-hero-greeting">Welcome back!</div>
          <div class="gd-hero-sub" id="gd-hero-sub">Let's see what's new since last time.</div>
        </div>
        <div class="gd-hero-stats">
          <div class="gd-pebble gold">
            <div class="gd-pebble-val" id="gd-stat-badges">—</div>
            <div class="gd-pebble-label">BADGES</div>
          </div>
          <div class="gd-pebble">
            <div class="gd-pebble-val" id="gd-stat-milestones">—</div>
            <div class="gd-pebble-label">GOALS HIT</div>
          </div>
        </div>
      </div>

      <!-- ── MODULES (moved up top — this is what kids actually click) ── -->
      <div class="hil-section-label">PICK SOMETHING TO WORK ON</div>
      <div class="module-grid">

        <div class="module-card">
          <div class="module-icon-circle">🧠</div>
          <div class="module-title">Guild Incubator</div>
          <div class="module-desc">
            Build your own personal wiki — write up your skills, projects, and the stuff you're good at. It's yours, and it travels with you.
          </div>
          <a href="./guild-incubator/hil-incubator-generator.html" style="display:inline-block">
            <button class="hil-btn primary">Open Incubator →</button>
          </a>
        </div>

        <div class="module-card">
          <div class="module-icon-circle">🌦</div>
          <div class="module-title">Weather Spotters</div>
          <div class="module-desc">
            Guess tomorrow's weather, then check how close you got. Short lessons along the way build toward your own Weather Journal.
          </div>
          <a href="./hil-weather-spotters.html" style="display:inline-block">
            <button class="hil-btn primary">Open Weather Spotters →</button>
          </a>
        </div>

        <div class="module-card">
          <div class="module-icon-circle">⚡</div>
          <div class="module-title">Electric Forge</div>
          <div class="module-desc">
            Six hands-on electrical labs — wire gauge, multimeter probes, motors, solar & battery, circuits, and panel wiring. Real formulas, real trade-offs.
          </div>
          <a href="./electric-forge/" style="display:inline-block">
            <button class="hil-btn primary">Open Electric Forge →</button>
          </a>
        </div>

        <div class="module-card">
          <div class="module-icon-circle">🏷️</div>
          <div class="module-title">Foundations</div>
          <div class="module-desc">
            The grammar underneath everything else in HIL — root nouns and classification logic. Start with Noun First Lab.
          </div>
          <a href="./foundations/" style="display:inline-block">
            <button class="hil-btn primary">Open Foundations →</button>
          </a>
        </div>

        <div class="module-card">
          <div class="module-icon-circle">📏</div>
          <div class="module-title">Weights &amp; Measures</div>
          <div class="module-desc">
            Read and use real measuring tools correctly — ruler, protractor, and more on the way. Start with Ruler Simulator.
          </div>
          <a href="./weights-measures/" style="display:inline-block">
            <button class="hil-btn primary">Open Weights &amp; Measures →</button>
          </a>
        </div>

        <div class="module-card">
          <div class="module-icon-circle">📊</div>
          <div class="module-title">Scoreboard</div>
          <div class="module-desc">
            Every hour, drill, and mastery verdict logged across every module — hours by subject, accuracy where it applies, and a printable progress report.
          </div>
          <a href="./hil-guild-scores.html" style="display:inline-block">
            <button class="hil-btn primary">Open Scoreboard →</button>
          </a>
        </div>

        <div class="module-card">
          <div class="module-icon-circle">🧮</div>
          <div class="module-title">Calculator Explorer</div>
          <div class="module-desc">
            Every button on the calculator, explained — tap one to learn what it does. Other modules point you here when they need a specific key.
          </div>
          <a href="./hil-calculator-explorer.html" style="display:inline-block">
            <button class="hil-btn primary">Open Calculator Explorer →</button>
          </a>
        </div>

        <div class="module-card dim">
          <div class="module-icon-circle">🎸</div>
          <div class="module-title">Guild Music School</div>
          <div class="module-desc">
            Guitar, banjo, and harmonica lessons that remember where you left off. Still being built — hang tight.
          </div>
          <button class="hil-btn" disabled style="opacity:0.5;cursor:default">Coming soon</button>
        </div>

      </div>

      <!-- ── CUSTOM GOALS & CHALLENGES ── -->
      <div class="hil-section-label">CUSTOM GOALS & CHALLENGES</div>
      <div class="toolbar" style="display:flex;gap:8px;margin-bottom:14px">
        <button class="hil-btn primary" id="add-goal-btn">+ Set My Own Goal</button>
        <button class="hil-btn" id="add-challenge-btn">+ Issue a Challenge</button>
      </div>
      <div id="goal-list">
        <div class="hil-empty"><div class="hil-empty-icon">🎯</div>No custom goals yet — set one above.</div>
      </div>

      <div id="custom-badge-wrap" style="display:none">
        <div class="hil-section-label">CUSTOM BADGES EARNED</div>
        <div class="custom-badge-grid" id="custom-badge-grid"></div>
      </div>

      <!-- ── BADGES ── -->
      <div class="hil-section-label">BADGES YOU'VE EARNED</div>
      <div class="badge-grid" id="badge-grid">
        <div class="hil-empty" style="grid-column:1/-1"><div class="hil-empty-icon">🏅</div>No badges yet — they show up as you use the system.</div>
      </div>

      <!-- ── MILESTONES ── -->
      <div class="hil-section-label">GOALS IN PROGRESS</div>
      <div id="milestone-list">
        <div class="hil-empty"><div class="hil-empty-icon">🎯</div>Nothing tracked yet.</div>
      </div>

    </div><!-- /member-view -->
  </main>
</div>

<!-- ── CUSTOM GOAL / CHALLENGE MODAL ── -->
<div class="hil-modal-overlay" id="goal-modal">
  <div class="hil-modal">
    <div class="hil-modal-header">
      <span id="goal-modal-title">SET A GOAL</span>
      <button class="hil-modal-close" data-close="goal-modal">✕</button>
    </div>
    <div class="hil-modal-body">
      <input type="hidden" id="goal-issued-by" value="self">
      <div class="hil-field">
        <label class="hil-label">NAME *</label>
        <input class="hil-input" id="goal-name" placeholder="Lego Builder">
      </div>
      <div class="hil-grid-2">
        <div class="hil-field">
          <label class="hil-label">ICON (emoji)</label>
          <input class="hil-input" id="goal-icon" placeholder="🧱" maxlength="4">
        </div>
        <div class="hil-field">
          <label class="hil-label">TARGET HOURS (blank = manual complete)</label>
          <input class="hil-input" type="number" step="0.5" id="goal-target-hours" placeholder="5">
        </div>
      </div>
      <div class="hil-field">
        <label class="hil-label">DESCRIPTION</label>
        <textarea class="hil-textarea" id="goal-desc" placeholder="Spend time building and get a badge for it."></textarea>
      </div>
    </div>
    <div class="hil-modal-footer">
      <button class="hil-btn" data-close="goal-modal">CANCEL</button>
      <button class="hil-btn primary" id="save-goal-btn">SAVE</button>
    </div>
  </div>
</div>

<script type="module">
// ── BADGE CATALOG ──────────────────────────────────────────────────────────
// Mirrors BADGE_CATALOG in hil-family-ledger.html exactly. Ledger triggers
// awards (writes to team_members/{id}/badges); Guild only reads + displays.
// Keep these two lists in sync until a shared module is set up.
const BADGE_CATALOG = [
  {id:'first-item',        icon:'📦', name:'First Item',       category:'Stewardship', desc:'First item catalogued in the vault'},
  {id:'at-address',        icon:'📍', name:'At Address',        category:'Stewardship', desc:'5 items assigned HL addresses'},
  {id:'first-donation',    icon:'💚', name:'First Donation',    category:'Circulation', desc:'First donation logged'},
  {id:'first-trade',       icon:'🔄', name:'First Trade',       category:'Circulation', desc:'First trade completed'},
  {id:'provenance-keeper', icon:'📖', name:'Provenance Keeper', category:'Stewardship', desc:'Added provenance narrative to 3 items'},
  {id:'pattern-finder',    icon:'🔍', name:'Pattern Finder',    category:'Awareness',   desc:'Viewed portfolio projection'},
  {id:'giver',             icon:'🌱', name:'The Giver',         category:'Circulation', desc:'Donated 3+ items in a month'},
  {id:'archivist',         icon:'🏛', name:'Archivist',         category:'Stewardship', desc:'10+ items catalogued with photos'},
  {id:'weather-watcher',   icon:'🌤', name:'Weather Watcher',   category:'Awareness',   desc:'Logged 5 weather observations'},
  {id:'junior-meteorologist', icon:'⛈', name:'Junior Meteorologist', category:'Growth', desc:'Completed all Weather Spotters lessons'},
];

// ── MILESTONE CATALOG ──────────────────────────────────────────────────────
// Milestones are persisted to Firestore (see schema note near checkMilestones).
// Frontend-writable, same doctrine as badges.
const MILESTONE_CATALOG = [
  {id:'item-tracker-10',    icon:'🏅', name:'Item Tracker',    metric:'items',     target:10, desc:n=>`${n} / 10 items catalogued`,          reward_badge_id:'archivist'},
  {id:'donation-streak-3',  icon:'💚', name:'Donation Streak', metric:'donations', target:3,  desc:n=>`${n} / 3 donations logged`,            reward_badge_id:'giver'},
  {id:'fair-trader-2',      icon:'🔄', name:'Fair Trader',     metric:'trades',    target:2,  desc:n=>`${n} / 2 trades completed`,            reward_badge_id:'first-trade'},
];

function catBadgeColor(cat) {
  return {Stewardship:'green', Circulation:'amber', Growth:'blue', Awareness:'gold', Execution:'gray'}[cat] || 'gray';
}

// Rotating, low-key sub-greetings so the banner doesn't feel static.
const HERO_SUBS = [
  "Let's see what's new since last time.",
  "Ready to earn something today?",
  "Pick a mission below to get started.",
  "Nice work so far — keep it going.",
];

// ── STATE ──
let allMembers      = [];
let activeMember    = null;
let memberItems     = [];
let memberDonations = [];
let memberTrades    = [];
let memberBadges    = [];
let memberMilestones = [];
let memberCustomBadges = [];   // users/{uid}/team_members/{id}/custom_badges
let memberSessionLog   = [];   // users/{uid}/team_members/{id}/session_log_entries (custom-goal entries only, client-filtered)
let activeTimer = null;        // { badgeId, startedAtMs }
let timerInterval = null;

let _collection, _doc, _addDoc, _onSnapshot, _serverTimestamp, _updateDoc;

HILShell.init({
  toolId:      'guild',
  toolName:    'Guild',
  requireAuth: true,
  onAuth:      handleAuth,
});

async function handleAuth(user) {
  if (!user) return;

  const FB_BASE = 'https://www.gstatic.com/firebasejs/10.12.0';
  const fsdk = await import(`${FB_BASE}/firebase-firestore.js`);
  _collection      = fsdk.collection;
  _doc             = fsdk.doc;
  _addDoc          = fsdk.addDoc;
  _onSnapshot      = fsdk.onSnapshot;
  _serverTimestamp = fsdk.serverTimestamp;
  _updateDoc       = fsdk.updateDoc;

  const db = window.db;

  _onSnapshot(_collection(db, 'users', user.uid, 'team_members'), snap => {
    allMembers = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderMemberList();
  });
}

function esc(s) {
  return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

// ── MEMBER LIST ──
function renderMemberList() {
  const list = document.getElementById('member-list');
  if (!allMembers.length) {
    list.innerHTML = `<div style="padding:12px 16px;font-family:var(--font-mono);font-size:10px;color:var(--hil-text-muted)">No members yet. Add one in Family Ledger.</div>`;
    document.getElementById('no-member-view').style.display = 'block';
    document.getElementById('member-view').style.display = 'none';
    return;
  }

  // Auto-select so the dashboard shows immediately — no manual "pick someone" step.
  if (!activeMember || !allMembers.find(m => m.id === activeMember.id)) {
    const defaultMember =
      allMembers.find(m => m.linked_uid === window.currentUser?.uid) ||
      allMembers.find(m => m.role === 'family') ||
      allMembers[0];
    if (defaultMember) {
      selectMember(defaultMember.id);
      return; // selectMember() re-renders the list itself
    }
  }

  list.innerHTML = allMembers.map(m => `
    <div class="gd-member-card ${activeMember?.id === m.id ? 'active' : ''}" onclick="selectMember('${m.id}')">
      <div class="gd-member-name">${esc(m.name)}</div>
      <div class="gd-member-meta">${esc(m.role || 'member')}</div>
    </div>
  `).join('');
}

window.selectMember = function (id) {
  stopTimerNoSave();
  activeMember = allMembers.find(m => m.id === id);
  if (!activeMember) return;
  renderMemberList();
  document.getElementById('no-member-view').style.display = 'none';
  document.getElementById('member-view').style.display = 'block';

  const first = (activeMember.name || '').split(' ')[0];
  document.getElementById('gd-hero-greeting').textContent = `Hey ${first}! 👋`;
  document.getElementById('gd-hero-sub').textContent = HERO_SUBS[Math.floor(Math.random() * HERO_SUBS.length)];

  loadMemberData(id);
};

function loadMemberData(memberId) {
  const db  = window.db;
  const uid = window.currentUser?.uid;
  if (!db || !uid) return;

  _onSnapshot(_collection(db, 'users', uid, 'item_records'), snap => {
    memberItems = snap.docs.map(d => ({ id: d.id, ...d.data() })).filter(i => i.team_member_id === memberId);
    checkMilestones();
  });

  _onSnapshot(_collection(db, 'users', uid, 'team_members', memberId, 'donations'), snap => {
    memberDonations = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    checkMilestones();
  });

  _onSnapshot(_collection(db, 'users', uid, 'team_members', memberId, 'trades'), snap => {
    memberTrades = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    checkMilestones();
  });

  _onSnapshot(_collection(db, 'users', uid, 'team_members', memberId, 'badges'), snap => {
    memberBadges = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderBadges();
  });

  _onSnapshot(_collection(db, 'users', uid, 'team_members', memberId, 'milestones'), snap => {
    memberMilestones = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderMilestones();
  });

  _onSnapshot(_collection(db, 'users', uid, 'team_members', memberId, 'custom_badges'), snap => {
    memberCustomBadges = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderGoals();
  });

  _onSnapshot(_collection(db, 'users', uid, 'team_members', memberId, 'session_log_entries'), snap => {
    memberSessionLog = snap.docs.map(d => ({ id: d.id, ...d.data() })).filter(e => e.entry_type === 'custom_goal_activity');
    renderGoals();
  });
}

// ── BADGES (display only — award logic lives in Family Ledger) ──
function renderBadges() {
  const earnedIds = memberBadges.map(b => b.badge_id);
  document.getElementById('gd-stat-badges').textContent = memberBadges.length;

  document.getElementById('badge-grid').innerHTML = BADGE_CATALOG.map(badge => {
    const earned = earnedIds.includes(badge.id);
    const earnedBadge = memberBadges.find(b => b.badge_id === badge.id);
    return `
    <div class="badge-card ${earned ? 'earned' : 'locked'}">
      <span class="badge-icon">${badge.icon}</span>
      <div class="badge-name">${badge.name}</div>
      <div class="badge-cat"><span class="hil-badge ${catBadgeColor(badge.category)}">${badge.category.toUpperCase()}</span></div>
      <div class="badge-desc">${badge.desc}</div>
      ${earned
        ? `<div class="badge-date">Earned ${earnedBadge?.earned_at?.toDate?.().toLocaleDateString() || '—'}</div>`
        : `<div class="badge-locked-label">🔒 Not yet earned</div>`
      }
    </div>`;
  }).join('');
}

// ── MILESTONES ──
// Firestore schema:
//   users/{uid}/team_members/{memberId}/milestones/{milestoneId}
//   { milestone_id, name, desc, icon, category, criteria:{metric,target},
//     progress, reward_badge_id, completed_at, owner_uid, created_at, updated_at }
// Frontend-writable — same doctrine as badges (gamification layer, not
// inventory truth; see Authority Layer Doctrine).
function currentValueFor(metric) {
  if (metric === 'items')     return memberItems.length;
  if (metric === 'donations') return memberDonations.length;
  if (metric === 'trades')    return memberTrades.filter(t => t.status === 'accepted').length;
  return 0;
}

async function checkMilestones() {
  const user = window.currentUser;
  if (!user || !activeMember) return;

  for (const m of MILESTONE_CATALOG) {
    const value = currentValueFor(m.metric);
    const already = memberMilestones.find(x => x.milestone_id === m.id);
    if (already?.completed_at) continue;
    if (value < m.target) continue;

    try {
      await _addDoc(
        _collection(window.db, 'users', user.uid, 'team_members', activeMember.id, 'milestones'),
        {
          milestone_id: m.id,
          name: m.name,
          desc: m.desc(value),
          icon: m.icon,
          criteria: { metric: m.metric, target: m.target },
          progress: 1,
          reward_badge_id: m.reward_badge_id,
          owner_uid: user.uid,
          completed_at: _serverTimestamp(),
          created_at: _serverTimestamp(),
        }
      );
      HILShell.toast(`🎯 Nice! You hit a goal: ${m.name}`, 'success');
    } catch (e) { console.warn('Milestone write failed', e); }
  }
  renderMilestones();
}

function renderMilestones() {
  const completedCount = memberMilestones.filter(m => m.completed_at).length;
  document.getElementById('gd-stat-milestones').textContent = completedCount;

  document.getElementById('milestone-list').innerHTML = MILESTONE_CATALOG.map(m => {
    const value = currentValueFor(m.metric);
    const done  = memberMilestones.find(x => x.milestone_id === m.id && x.completed_at);
    const progress = Math.min(value / m.target, 1);
    return `
    <div class="milestone-row ${done ? 'completed' : ''}">
      <div class="milestone-icon">${done ? '✅' : m.icon}</div>
      <div>
        <div class="milestone-name">${m.name}</div>
        <div class="milestone-desc">${m.desc(value)}</div>
        <div class="progress-bar"><div class="progress-fill" style="width:${Math.round(progress * 100)}%"></div></div>
      </div>
      <div class="milestone-reward">${done ? `<span class="done">EARNED</span>` : `unlocks: ${m.reward_badge_id}`}</div>
    </div>`;
  }).join('');
}

// ── CUSTOM GOALS & CHALLENGES ──
// Firestore schema:
//   users/{uid}/team_members/{memberId}/custom_badges/{badgeId}
//   { name, icon, desc, target_hours: number|null, issued_by: "self"|"parent",
//     status: "active"|"earned", earned_at, owner_uid, created_at, updated_at }
// Time is logged via the locked Session Log spec (v2.0): Wrap Up + heartbeat,
// writing users/{uid}/team_members/{memberId}/session_log_entries with
// module_id: 'custom-badge-'+badgeId, entry_type: 'custom_goal_activity',
// accuracy: null, outcome: null (honest-time, no-score path — same as
// Solar & Battery Lab / Circuit Lab). Frontend-writable, same doctrine as badges.

window.openModal  = id => document.getElementById(id)?.classList.add('open');
window.closeModal = id => document.getElementById(id)?.classList.remove('open');
document.querySelectorAll('[data-close]').forEach(btn => btn.addEventListener('click', () => closeModal(btn.dataset.close)));
document.querySelectorAll('.hil-modal-overlay').forEach(ov => ov.addEventListener('click', e => { if (e.target === ov) closeModal(ov.id); }));

document.getElementById('add-goal-btn').addEventListener('click', () => openGoalModal('self'));
document.getElementById('add-challenge-btn').addEventListener('click', () => openGoalModal('parent'));

function openGoalModal(issuedBy) {
  if (!activeMember) { HILShell.toast('Select a member first', 'error'); return; }
  document.getElementById('goal-issued-by').value = issuedBy;
  setText2('goal-modal-title', issuedBy === 'parent' ? 'ISSUE A CHALLENGE' : 'SET A GOAL');
  ['goal-name','goal-icon','goal-desc','goal-target-hours'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
  document.getElementById('goal-icon').value = '🎯';
  openModal('goal-modal');
}
function setText2(id, v) { const el = document.getElementById(id); if (el) el.textContent = v; }

document.getElementById('save-goal-btn').addEventListener('click', async () => {
  const user = window.currentUser; if (!user || !activeMember) return;
  const name = document.getElementById('goal-name').value.trim();
  if (!name) { HILShell.toast('Name required', 'error'); return; }
  const targetRaw = document.getElementById('goal-target-hours').value;
  const data = {
    name,
    icon: document.getElementById('goal-icon').value.trim() || '🎯',
    desc: document.getElementById('goal-desc').value.trim() || null,
    target_hours: targetRaw ? parseFloat(targetRaw) : null,
    issued_by: document.getElementById('goal-issued-by').value,
    status: 'active',
    earned_at: null,
    owner_uid: user.uid,
    created_at: _serverTimestamp(),
    updated_at: _serverTimestamp(),
  };
  try {
    await _addDoc(_collection(window.db, 'users', user.uid, 'team_members', activeMember.id, 'custom_badges'), data);
    HILShell.toast('Goal saved ✓');
    closeModal('goal-modal');
  } catch (e) { HILShell.toast('Save failed: ' + e.message, 'error'); }
});

function hoursLoggedFor(badgeId) {
  return memberSessionLog
    .filter(e => e.module_id === 'custom-badge-' + badgeId)
    .reduce((sum, e) => sum + (e.credited_hours || 0), 0);
}

function fmtHM(hoursDecimal) {
  const totalMin = Math.round(hoursDecimal * 60);
  const h = Math.floor(totalMin / 60), m = totalMin % 60;
  return h > 0 ? `${h}h ${m}m` : `${m}m`;
}

function renderGoals() {
  const active = memberCustomBadges.filter(b => b.status === 'active');
  const earned = memberCustomBadges.filter(b => b.status === 'earned');

  const listEl = document.getElementById('goal-list');
  if (!active.length) {
    listEl.innerHTML = `<div class="hil-empty"><div class="hil-empty-icon">🎯</div>No custom goals yet — set one above.</div>`;
  } else {
    listEl.innerHTML = active.map(b => {
      const logged = hoursLoggedFor(b.id);
      const isTimed = b.target_hours != null;
      const progressPct = isTimed ? Math.min(100, Math.round((logged / b.target_hours) * 100)) : 0;
      const timerRunning = activeTimer && activeTimer.badgeId === b.id;
      return `
      <div class="goal-card ${b.issued_by === 'parent' ? 'challenge' : ''}">
        <div class="goal-top">
          <span class="goal-icon">${b.icon}</span>
          <div>
            <div class="goal-name">${esc(b.name)} ${b.issued_by === 'parent' ? '<span class="hil-badge amber">CHALLENGE</span>' : ''}</div>
          </div>
        </div>
        ${b.desc ? `<div class="goal-desc">${esc(b.desc)}</div>` : ''}
        ${isTimed ? `
          <div class="goal-timer-row">
            <span class="goal-timer-display" id="timer-display-${b.id}">${timerRunning ? '00:00' : fmtHM(logged)}</span>
            ${timerRunning
              ? `<button class="hil-btn primary" onclick="wrapUpTimer('${b.id}')">Wrap Up</button>`
              : `<button class="hil-btn" onclick="startTimer('${b.id}')">Start Session</button>`}
          </div>
          <div class="progress-bar" style="margin-top:8px"><div class="progress-fill" style="width:${progressPct}%"></div></div>
          <div class="goal-progress-label">${fmtHM(logged)} / ${fmtHM(b.target_hours)}</div>
        ` : `
          <button class="hil-btn primary" onclick="markGoalComplete('${b.id}')">Mark Complete</button>
        `}
      </div>`;
    }).join('');
  }

  const wrap = document.getElementById('custom-badge-wrap');
  if (earned.length) {
    wrap.style.display = 'block';
    document.getElementById('custom-badge-grid').innerHTML = earned.map(b => `
      <div class="badge-card earned">
        <span class="badge-icon">${b.icon}</span>
        <div class="badge-name">${esc(b.name)}</div>
        <div class="badge-cat"><span class="hil-badge ${b.issued_by==='parent'?'amber':'green'}">${b.issued_by==='parent'?'CHALLENGE':'PERSONAL GOAL'}</span></div>
        <div class="badge-date">Earned ${b.earned_at?.toDate?.().toLocaleDateString() || '—'}</div>
      </div>
    `).join('');
  } else {
    wrap.style.display = 'none';
  }
}

window.markGoalComplete = async function(badgeId) {
  const user = window.currentUser; if (!user || !activeMember) return;
  try {
    await _updateDoc(_doc(window.db, 'users', user.uid, 'team_members', activeMember.id, 'custom_badges', badgeId), {
      status: 'earned', earned_at: _serverTimestamp(), updated_at: _serverTimestamp(),
    });
    HILShell.toast('🏅 Marked complete!', 'success');
  } catch (e) { HILShell.toast('Failed: ' + e.message, 'error'); }
};

window.startTimer = function(badgeId) {
  if (activeTimer) { HILShell.toast('Wrap up your current session first', 'error'); return; }
  activeTimer = { badgeId, startedAtMs: Date.now() };
  timerInterval = setInterval(() => {
    const el = document.getElementById('timer-display-' + badgeId);
    if (!el) return;
    const elapsedSec = Math.floor((Date.now() - activeTimer.startedAtMs) / 1000);
    const mm = String(Math.floor(elapsedSec / 60)).padStart(2, '0');
    const ss = String(elapsedSec % 60).padStart(2, '0');
    el.textContent = `${mm}:${ss}`;
  }, 1000);
  renderGoals();
};

function stopTimerNoSave() {
  if (timerInterval) clearInterval(timerInterval);
  timerInterval = null;
  activeTimer = null;
}

window.wrapUpTimer = async function(badgeId) {
  const user = window.currentUser;
  if (!user || !activeMember || !activeTimer || activeTimer.badgeId !== badgeId) return;
  const elapsedHours = (Date.now() - activeTimer.startedAtMs) / 3600000;
  stopTimerNoSave();
  if (elapsedHours < (1/60)) { renderGoals(); return; } // ignore sub-minute accidental starts

  const badge = memberCustomBadges.find(b => b.id === badgeId);
  try {
    await _addDoc(_collection(window.db, 'users', user.uid, 'team_members', activeMember.id, 'session_log_entries'), {
      owner_uid: user.uid,
      member_id: activeMember.id,
      module_id: 'custom-badge-' + badgeId,
      entry_type: 'custom_goal_activity',
      subjects: [],
      concepts: [],
      accuracy: null,
      outcome: null,
      credited_hours: Math.round(elapsedHours * 100) / 100,
      description: badge ? `Worked on: ${badge.name}` : 'Custom goal session',
      auto_flushed: false,
      created_at: _serverTimestamp(),
    });
    HILShell.toast(`Logged ${fmtHM(elapsedHours)} ✓`);

    // Auto-award check
    if (badge && badge.target_hours != null) {
      const totalLogged = hoursLoggedFor(badgeId) + elapsedHours; // memberSessionLog snapshot may lag by one tick
      if (totalLogged >= badge.target_hours) {
        await _updateDoc(_doc(window.db, 'users', user.uid, 'team_members', activeMember.id, 'custom_badges', badgeId), {
          status: 'earned', earned_at: _serverTimestamp(), updated_at: _serverTimestamp(),
        });
        HILShell.toast(`🏅 Goal reached: ${badge.name}!`, 'success');
      }
    }
  } catch (e) { HILShell.toast('Could not log session: ' + e.message, 'error'); }
};

window.addEventListener('beforeunload', () => {
  // Safety net matching the locked spec's auto_flushed fallback — best-effort only,
  // browsers don't reliably allow async writes here, so this is not guaranteed.
  if (activeTimer) stopTimerNoSave();
});
</script>

</body>
</html>
